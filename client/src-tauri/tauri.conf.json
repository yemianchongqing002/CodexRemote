{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Remote Client",
  "version": "1.0.0",
  "identifier": "com.example.codexremoteclient",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node ../scripts/bundle-servers.cjs",
    "features": [
      "desktop-direct"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Codex Remote · 连接",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https: http:; media-src 'self' blob: https: http:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'self'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [
      "server-bundles/"
    ],
    "macOS": {
      "files": {
        "MacOS/codex-remote-service": "local-service-bundle/codex-remote-service"
      }
    }
  }
}
